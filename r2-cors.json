{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://swell.fyi",
          "http://localhost:4747"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "range",
          "if-match"
        ]
      },
      "exposeHeaders": [
        "etag"
      ],
      "maxAgeSeconds": 3000
    }
  ]
}
