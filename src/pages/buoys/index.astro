---
import Base from "../../layouts/Base.astro";
// The station list is built in; the readings fill in from the swell-data Worker.
import { stationList, isWaveStation } from "../../lib/local";
import { cleanName } from "../../lib/surf";

const stations = await stationList();
const wave = stations.filter(isWaveStation).sort((a, b) => b.lat - a.lat);
const other = stations.filter((s) => !isWaveStation(s)).sort((a, b) => b.lat - a.lat);
---
<Base title="Buoys">
  <section class="detail-head">
    <h1 class="headline small" style="margin-top: 28px"><span class="en">CWA marine stations</span> <span class="zh" lang="zh-Hant">浮標</span></h1>
    <p class="facts">
      Every station in CWA's marine observation feed (O-B0075-001), north to south. Most are run by CWA; others by the Water Resources Agency,
      the National Academy of Marine Research (OAC) or National Taiwan University, and CWA republishes them. Each station page has the archived history and a CSV download.
    </p>
  </section>

  <section class="buoys-panel" style="margin-top: 36px">
    <h2>Wave stations ({wave.length})</h2>
    <div class="scroll">
      <table class="data">
        <thead>
          <tr><th>Station</th><th>ID</th><th>County</th><th class="n">Wave height</th><th class="n">Period</th><th>From</th><th class="n">Wind</th><th class="n">Water</th><th>Reading</th><th>Archive since</th></tr>
        </thead>
        <tbody>
          {wave.map((s) => (
            <tr data-station={s.id}>
              <td><a href={`/buoys/${s.id}/`}>{cleanName(s.nameEn)}</a> <span class="faint" lang="zh-Hant">{s.name}</span></td>
              <td class="faint">{s.id}</td>
              <td class="faint">{s.county}</td>
              <td class="n"><strong data-v="hs">–</strong></td>
              <td class="n" data-v="tp">–</td>
              <td data-v="dir"></td>
              <td class="n" data-v="wind">–</td>
              <td class="n" data-v="water">–</td>
              <td class="faint" data-v="age">–</td>
              <td class="faint" data-v="since">–</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="buoys-panel">
    <h2>Tide and weather stations ({other.length})</h2>
    <div class="scroll">
      <table class="data">
        <thead><tr><th>Station</th><th>ID</th><th>Type</th><th>County</th><th class="n">Tide</th><th class="n">Water</th><th class="n">Wind</th></tr></thead>
        <tbody>
          {other.map((s) => (
            <tr data-station={s.id}>
              <td><a href={`/buoys/${s.id}/`}>{s.nameEn}</a> <span class="faint" lang="zh-Hant">{s.name}</span></td>
              <td class="faint">{s.id}</td>
              <td class="faint">{s.typeEn}</td>
              <td class="faint">{s.county}</td>
              <td class="n" data-v="tide">–</td>
              <td class="n" data-v="water">–</td>
              <td class="n" data-v="wind">–</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <script>
    import { loadStations } from "../../lib/data";
    import { fmt, compass } from "../../lib/format";
    import { arrowSvg } from "../../lib/glyphs";
    loadStations().then((list) => {
      for (const s of list) {
        const row = document.querySelector(`[data-station="${s.id}"]`);
        if (!row) continue;
        const v = s.latest?.values ?? {};
        const set = (k: string, html: string) => { const el = row.querySelector(`[data-v="${k}"]`); if (el) el.innerHTML = html; };
        const a = s.latest ? Math.round((Date.now() - Date.parse(s.latest.time)) / 36e5) : null;
        set("hs", fmt(v.wave_height_m, 1, " m"));
        set("tp", fmt(v.wave_period_s, 1, " s"));
        set("dir", `${arrowSvg(v.wave_dir_deg, 12)} ${compass(v.wave_dir_deg)}`);
        set("wind", `${fmt(v.wind_speed_ms, 1, " m/s")} ${v.wind_speed_ms != null ? compass(v.wind_dir_deg) : ""}`);
        set("water", fmt(v.sea_temp_c, 1, " °C"));
        set("tide", fmt(v.tide_height_m, 2, " m"));
        set("age", a == null ? "–" : a <= 1 ? "current" : `${a} h old`);
        set("since", s.latest?.archiveStart?.slice(0, 10) ?? "–");
        row.querySelector('[data-v="age"]')?.classList.toggle("old", a != null && a > 3);
      }
    }).catch(() => document.querySelectorAll('[data-v="age"]').forEach((el) => (el.textContent = "unavailable")));
  </script>
</Base>
