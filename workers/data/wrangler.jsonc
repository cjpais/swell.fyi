{
  // Live data for swell.fyi: the explore map's field.json (Open-Meteo) and CWA's buoys, tides
  // and forecast, rebuilt on a cron, kept in R2 and served from the edge. Deploy: bun run deploy:data
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "swell-data",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "taiwan-waves" }],
  "routes": [{ "pattern": "data.swell.fyi", "custom_domain": true }],
  "workers_dev": false,
  // Every 10 min: cheap checks of Open-Meteo's model metadata and CWA's S3 ETags. A part is
  // only rebuilt when its upstream changed (field: ~6 times a day; CWA obs: hourly; WRF: 4 runs a day).
  "triggers": { "crons": ["*/10 * * * *"] },
  "limits": { "cpu_ms": 60000 },
  "observability": { "enabled": true }
  // Secrets: REFRESH_TOKEN (for POST /refresh); optional OPEN_METEO_API_KEY, CWA_API_KEY.
  //   npx wrangler secret put NAME -c workers/data/wrangler.jsonc
}
