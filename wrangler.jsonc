{
  // Static site on Cloudflare Workers (assets only, no server code).
  // Deploy: bun run build && npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swell-fyi",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "swell.fyi", "custom_domain": true }],
  "workers_dev": false
}
